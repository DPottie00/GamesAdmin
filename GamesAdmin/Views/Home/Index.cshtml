@{
    ViewData["Title"] = "Home Page";
}

<div class="">
    <div class="text-center d-flex flex-column">
        <h1 class="display-4">Welcome to The Loot Table's Admin Dashboard</h1>
        <p>The Loot Table is a video game review platform, but since you're here, I'm sure you knew that already.</p>
        <div class= "d-flex">
            <div class="d-flex w-50 justify-content-end pe-2">
                <a class="btn btn-primary btn-lg" asp-area="" asp-controller="Games" asp-action="Index">View Game Listings</a>            
            </div>
            <div class="d-flex w-50 justify-content-start ps-2">
                <a class="btn btn-primary btn-lg" asp-area="" asp-controller="Games" asp-action="Create">Add a Game</a>
            </div>
         </div>
    </div>
</div>