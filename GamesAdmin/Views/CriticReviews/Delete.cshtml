@model GamesAdmin.Models.CriticReview

@{
    ViewData["Title"] = "Delete Critic Review";
}

<h1>DELETING REVIEW</h1>

<h3>Are you sure you want to delete this review?</h3>
<p>This review can no longer be recoverd once deleted</p>
<div>
    <hr />
    <h4>@Model.Game.Title</h4>
    
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Description)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Description)</dd>
        <h4>@Model.Rating / 5</h4>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
