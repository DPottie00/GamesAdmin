@model GamesAdmin.Models.CriticReview
@{
    ViewData["Title"] = "Create New Critic Review";
}

<h1>Review: @ViewBag.GameTitle</h1>
<div class="row">
    <div class="col-9">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" name="GameId" value="@ViewBag.GameId" />

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Rating" class="form-label"></label>
                <input asp-for="Rating" class="form-control" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>
            <button type="submit" name="isPublished" value="false" class="btn btn-secondary">
                Save as Draft
            </button>

            <button type="submit" name="isPublished" value="true" class="btn btn-primary">
                Publish
            </button>

            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
    <div class="col-3">
        <img src="@ViewBag.GameImageUrl" alt="@ViewBag.GameTitle" class="img-thumbnail w-100" />
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
