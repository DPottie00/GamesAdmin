@model GamesAdmin.Models.CriticReview

@{
    ViewData["Title"] = "Review Details";
}

<div>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="">@Model.Game.Title</h1>
            <p>Review details</p>
        </div>

        @if (Model.isPublished)
        {
            <span class="badge bg-success fs-6">Published</span>
        }
        else
        {
            <span class="badge bg-secondary fs-6">Draft</span>
        }
    </div>

    <div>
        <div>
            <div class="row g-0">
                <div class="col-md-4 col-lg-3 pe-2">
                    <img src="@Model.Game.ImageUrl" alt="@Model.Game.Title" class="img-thumbnail w-100" />
                </div>
                <div class="col-md-8 col-lg-9 p-2 border rounded">
                    <h5 class="">Review</h5>
                    <p class="">@Model.Description</p>
                </div>

            </div>
        </div>
    </div>

    <div class="my-2 pt-1 px-2 border rounded">
        <div class="row">
            <div class="col-md-2">
                <p class="mb-1">Rating</p>
                <h4>@Model.Rating / 5</h4>
            </div>

            <div class="col-md-5">
                <p class="mb-1">@Html.DisplayNameFor(model => model.CreatedBy)</p>
                <p class="fw-semibold">@Model.CreatedBy</p>
            </div>
            <div class="col-md-5 text-end">
                @if (!Model.isPublished)
                {
                    <p class="mb-1">Draft Saved Date</p>
                } else
                {
                    <p class="mb-1">Published Date</p>
                }
                <p class="fw-semibold">@Model.CreatedDate</p>
            </div>
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (!Model.isPublished)
        {
            <a asp-action="Edit"
            asp-route-id="@Model.Id"
            class="btn btn-primary">
                Edit
            </a>
            <form asp-action="Publish" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-primary">
                    Publish
                </button>
            </form>
            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               method="post"
               class="btn btn-danger">
                Delete
            </a>
            <a asp-action="Index"
               class="btn btn-secondary">
                Back to Reviews
            </a>
        } else
        {
            <a asp-action="Index"
               class="btn btn-secondary">
                Back to Reviews
            </a>
        }

    </div>

</div>