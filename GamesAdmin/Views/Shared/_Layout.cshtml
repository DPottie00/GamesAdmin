<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The Loot Table - Admin</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GamesAdmin.styles.css" asp-append-version="true" />
</head>
<body class="@(ViewData["Title"]?.ToString() == "Home Page" ? "d-flex flex-column min-vh-100" : "")">
    <header>
        <nav class="navbar navbar-expand-lg navbar-toggleable-lg navbar-theme border-bottom box-shadow">  @* Making my own theme for navbar with my palette (using navbar-theme) *@
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">The Loot Table - Admin</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Games" asp-action="Index">Game List</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container @(ViewData["Title"]?.ToString() == "Home Page" ? "flex-grow-1 d-flex": "pb-auto" )">
        <main role="main" class="@(ViewData["Title"]?.ToString() == "Home Page" ? "flex-grow-1 d-flex justify-content-center align-items-center" : "mb-6")">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer footer-theme">
        <div class="container">
            &copy; 2026 - The Loot Table - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
