@model GamesAdmin.Models.Game

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Game Details</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>


            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Summary" class="formLabel"></label>
                <textarea asp-for="Summary" class="form-control" rows="5"></textarea>  
                <span asp-validation-for="Summary" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="GenreId" class="control-label"></label>
                <select asp-for="GenreId" class="form-select" asp-items="ViewBag.GenreId"></select>
            </div>

            <div class="mb-3">
                <label asp-for="AudienceRatingId" class="control-label"></label>
                <select asp-for="AudienceRatingId" class="form-select" asp-items="ViewBag.AudienceRatingId"></select>
            </div>
            <div class="mb-3">
                <label asp-for="TimeToBeat" class="formLabel"></label>
                <input asp-for="TimeToBeat" class="form-control" />
                <span asp-validation-for="TimeToBeat" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ReleaseDate" class="formLabel"></label>
                <input asp-for="ReleaseDate" type="date" class="form-control" />
                <span asp-validation-for="ReleaseDate" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Developer" class="formLabel"></label>
                <input asp-for="Developer" class="form-control" />
                <span asp-validation-for="Developer" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Platform" class="formLabel"></label>
                <input asp-for="Platform" class="form-control" />
                <span asp-validation-for="Platform" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <div class="mb-3">
                    <label>Upload New Image</label>
                    <input type="file" id="imageFile" name="imageFile" class="form-control image-upload" data-preview="imagePreview" />  @*data-.... adds to its data set, retrieved by JS, in this case, JS will fetch "imagePreview" which in turn refernces the img id below*@
                </div>
                <p>Image Preview:</p>
                <img src="@Model.ImageUrl" alt="@Model.Title" class="w-25 img-thumbnail" id="imagePreview"/>
            </div>
            <div class="mb-3">
                <input type="submit" value="Save" class="btn btn-primary my-2" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-primary">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/site.js"></script>
}
