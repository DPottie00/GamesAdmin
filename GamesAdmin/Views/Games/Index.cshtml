@model IEnumerable<GamesAdmin.Models.Game>

@{
    ViewData["Title"] = "Index";
}

<h1>Games</h1>
@if (User.IsInRole("administrator"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </p>
}
<table class="table table-hover">
    <thead>
        <tr>
            <th></th>

            @* Maybe add more sorting? *@
            <th>
                <a asp-action="Index" asp-route-sortOrder="title">
                    @Html.DisplayNameFor(model => model.Title)
                </a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AudienceRating)
            </th> 
            <th>
                <a asp-action="Index" asp-route-sortOrder="releaseDate">
                    @Html.DisplayNameFor(model => model.ReleaseDate)
                </a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Platform)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <img src="@item.ImageUrl" alt="@item.Title" class="thumbnail">
            </td>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.Genre.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.AudienceRating.Title)
            </td> 
            <td>
                @Html.DisplayFor(model => item.ReleaseDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.Platform.Name)
            </td>
            <td>
                @if (User.IsInRole("administrator"))
                {
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                }
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Details</a> 
                @if (User.IsInRole("critic"))
                {
                    <a asp-controller="CriticReviews" asp-action="Create" asp-route-gameId="@item.Id" class="btn btn-primary btn-sm">Post Review</a>
                }
                @if (User.IsInRole("administrator"))
                {
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Delete</a>
                }
                
            </td>
        </tr>
}
    </tbody>
</table>
