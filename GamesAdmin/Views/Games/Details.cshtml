@model GamesAdmin.Models.Game

@{
    ViewData["Title"] = "Details";
}

<div class ="container py-4">

    @*Title/Summary Box*@

        <div class="row mb-4">
            <div class="col-6">
                <h4>@Html.DisplayFor(model => model.Title)</h4>
            </div>
            <div class="col-6">
                <h6 class="text-end">Reviews: @Model.CriticReviews.Count</h6>
            </div>
            <div class="col-3">
                <img src="@Model.ImageUrl" alt="@Model.Title" class="img-thumbnail w-100"/>
            </div>
            <dl class="col-9">
                <dt>@Html.DisplayNameFor(model => model.Summary)</dt>
                <dd>@Html.DisplayFor(model => model.Summary)</dd>
            </dl>
        </div>
           
        @*Other Info Box*@
        <div class="row">
            <div class="col-md-6">
                <dl class="row">
                    <dt class = "col-sm-5">
                        @Html.DisplayNameFor(model => model.Genre)
                    </dt>
                    <dd class = "col-sm-7">
                        @Html.DisplayFor(model => model.Genre.Title)
                    </dd>
                    <dt class = "col-sm-5">
                        @Html.DisplayNameFor(model => model.AudienceRating)
                    </dt>
                    <dd class = "col-sm-7">
                    @Html.DisplayFor(model => model.AudienceRating.Title)
                    </dd>
                    <dt class = "col-sm-5">
                        Time To Beat
                    </dt>
                    <dd class = "col-sm-7">
                    
                    @*Math for Time*@    
                    @{
                        var hours = Model.TimeToBeat/60;
                        var minutes = Model.TimeToBeat % 60;
                    }

                    @if (hours > 0)
                    {
                        @($"{hours}h")
                    }

                    @if (minutes > 0)
                    {
                        @($" {minutes}m")
                    }
                    </dd>
                </dl>
            </div>
            <div class="col-md-6">
                <dl class="row">
                    <dt class = "col-sm-5">
                        @Html.DisplayNameFor(model => model.ReleaseDate)
                    </dt>
                    <dd class = "col-sm-7">
                        @Html.DisplayFor(model => model.ReleaseDate)
                    </dd>
                    <dt class = "col-sm-5">
                        @Html.DisplayNameFor(model => model.Developer)
                    </dt>
                    <dd class = "col-sm-7">
                        @Html.DisplayFor(model => model.Developer.Name)
                    </dd>
                    <dt class = "col-sm-5">
                        @Html.DisplayNameFor(model => model.Platform)
                    </dt>
                    <dd class = "col-sm-7">
                        @Html.DisplayFor(model => model.Platform.Name)
                    </dd>
                </dl>
            </div>
        </div>
        <hr /> 

    @* Buttons *@
    <div class="d-flex gap-2">
        @if (User.IsInRole("administrator"))
        {
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a>
        }
        <a asp-action="Index" class="btn btn-primary">Back to List</a>
        @if (User.IsInRole("critic"))
        {
            <a asp-controller="CriticReviews" asp-action="Create" asp-route-gameId="@Model?.Id" class="btn btn-primary">Post Review</a>
        }
    </div>
</div>